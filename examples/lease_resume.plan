description "Resume an existing lease and read DSP UART briefly."

# Replace REPLACE_WITH_YOUR_TOKEN with the lease_token value from
# the prior lease_claim.plan run's manifest.json:
#
#   python3 submit.py examples/lease_claim.plan \
#     --wait 5 --extract /tmp/lease
#   python3 -c 'import json; \
#     print(json.load(open("/tmp/lease/manifest.json"))["lease_token"])'
#
# Then, after substituting:
#   python3 submit.py examples/lease_resume.plan \
#     --wait 10 --extract /tmp/dsp-uart
#
# The dashboard auto-fills this token for you when you pick this
# plan from the example dropdown after a claim has run.

lease:resume token="REPLACE_WITH_YOUR_TOKEN"
dsp.A:uart_open
delay ms=2000
dsp.A:uart_close
