description "Probe the bench and dump device + op tables."

# Zero-hardware "hello world": the inventory control verb refreshes
# the poller's device probe and writes bench.devices.json + bench.ops.json
# into the artefact tar (top-level, alongside manifest.json). Useful
# as a smoke test that the server, poller, and SSH tunnel are all
# wired up before you trust any real test. Submit with:
#
#   python3 submit.py examples/inventory.plan --wait 30 --extract /tmp/inv
#
# Then read /tmp/inv/bench.devices.json to see what the poller can
# see, and bench.ops.json for the per-plugin op map.

inventory
